# ICT Institutional AI Trading Scanner - Environment Variables

# === Data Providers ===
# Historical offline path works without keys.
# Live data: set Twelve Data key to auto-switch provider.
TWELVE_DATA_API_KEY=
FCS_API_KEY=

# === Auth (optional) ===
# If set, API routes require header: X-API-Key: <value>
API_SECRET_KEY=

# === Redis (optional durable scheduler job store) ===
REDIS_URL=

# === Database ===
DATABASE_URL=sqlite:///./ict_scanner.db

# === Scheduler ===
SCAN_INTERVAL_MINUTES=20
ENABLE_SCHEDULER=true

# === Risk Defaults ===
DEFAULT_MIN_RR=2.0
DEFAULT_MIN_SCORE=80
DEFAULT_RISK_PERCENT=0.5
ACCOUNT_BALANCE=10000

# === AI Explanation (optional) ===
OPENAI_API_KEY=

# === Notifications (optional) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
