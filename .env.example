# ICT Institutional AI Trading Scanner - Environment Variables

# === Data Providers ===
# Historical data works without keys via Dukascopy libraries.
# Live data requires keys.

TWELVE_DATA_API_KEY=
FCS_API_KEY=
# Other providers as needed

# === Database ===
DATABASE_URL=sqlite:///./ict_scanner.db
# For production: postgresql://user:pass@host:5432/ict_scanner

# === Scheduler ===
SCAN_INTERVAL_MINUTES=20
ENABLE_SCHEDULER=true

# === Risk Defaults ===
DEFAULT_MIN_RR=2.0
DEFAULT_MIN_SCORE=80
DEFAULT_RISK_PERCENT=0.5
ACCOUNT_BALANCE=10000

# === AI Explanation (optional) ===
OPENAI_API_KEY=
# or other LLM provider

# === Notifications (optional) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === Security ===
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
